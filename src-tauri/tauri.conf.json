{
	"$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
	"build": {
		"beforeBuildCommand": "npm run prepublishOnly",
		"beforeDevCommand": "npm run prepublishOnly",
		"frontendDist": "../Target"
	},
	"productName": "tauri",
	"version": "2.0.0",
	"identifier": "media.blackrainbow.app",
	"bundle": {
		"active": true,
		"category": "News",
		"copyright": "Copyright (c) 2022-2023. All rights reserved.",
		"externalBin": [],
		"icon": [
			"Source/Image/16x16.png",
			"Source/Image/32x32.png",
			"Source/Image/icon.ico"
		],
		"longDescription": "",
		"resources": ["../Target/*"],
		"shortDescription": "",
		"targets": "all",
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": "",
			"wix": {
				"bannerPath": "Source/Image/banner.png",
				"dialogImagePath": "Source/Image/dialogImage.png"
			}
		}
	},
	"app": {
		"security": {
			"csp": null,
			"dangerousDisableAssetCspModification": true
		},
		"windows": [
			{
				"alwaysOnTop": true,
				"center": false,
				"decorations": false,
				"focus": true,
				"fullscreen": true,
				"label": "fa",
				"maximized": false,
				"resizable": false,
				"skipTaskbar": false,
				"title": "Follow aircraft.",
				"transparent": true,
				"url": "HTTPS://flightradar24.com",
				"visible": true,
				"x": 0,
				"y": 0
			},
			{
				"alwaysOnTop": true,
				"center": false,
				"decorations": false,
				"focus": true,
				"fullscreen": true,
				"label": "ta",
				"maximized": false,
				"resizable": false,
				"skipTaskbar": false,
				"title": "Twitter automate.",
				"transparent": true,
				"url": "HTTPS://tweetdeck.twitter.com",
				"visible": true,
				"x": 0,
				"y": 0
			}
		]
	}
}
